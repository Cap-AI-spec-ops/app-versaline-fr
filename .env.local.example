NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_LISTING_DESCRIPTION_MODEL=gemini-2.0-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_LISTING_DESCRIPTION_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1

MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
MISTRAL_LISTING_DESCRIPTION_MODEL=pixtral-12b-2409
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

XAI_API_KEY=YOUR_XAI_API_KEY
XAI_LISTING_DESCRIPTION_MODEL=grok-2-vision-1212
XAI_API_BASE_URL=https://api.x.ai/v1

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_BREVO_SMTP_USERNAME
SMTP_PASS=YOUR_BREVO_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@versaline.fr
SMTP_FROM_NAME=Versaline

DAILY_BRIEFING_CRON_SECRET=YOUR_LONG_RANDOM_SECRET
# Optional if you prefer Vercel's built-in cron auth variable naming:
CRON_SECRET=YOUR_LONG_RANDOM_SECRET

# Optional runtime overrides for daily briefing generation:
DAILY_BRIEFING_PROVIDER=gemini
DAILY_BRIEFING_MODEL=gemini-2.0-flash

# Twilio (add-on feature; must be enabled per company in Admin)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_MASTER_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN